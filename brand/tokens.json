{
  "$comment": [
    "Hora's design tokens: the one source. `python3 brand/src/tokens.py` rewrites every copy",
    "(crates/hora-web/assets/hora.css, brand/src/common.py, docs/src/styles/custom.css,",
    "docs/src/code-themes.mjs, crates/hora-web/src/heatmap.rs and layout.rs, brand/brand.md",
    "section 12) between their `tokens:begin` / `tokens:end` markers; `--check` fails on drift.",
    "A token is `name: value`, `name: {light, dark}` or either with a `note`. `{name}` refers to",
    "another token and stays a `var(--name)` in the stylesheets. A group may carry a `note`",
    "(a comment above it), `dense` (several tokens per line) and `only` (the consumers that",
    "get it: `brand` for the gallery, `docs` for the Starlight theme; default: product and gallery)."
  ],
  "groups": {
    "raw": {
      "note": "raw palette: synthe.se (2026-08-17), unchanged",
      "dense": true,
      "tokens": {
        "raw-cloud": "#f2f0ea",
        "raw-cloud-deep": "#e7e4db",
        "raw-ink": "#1b222c",
        "raw-ink-soft": "#525a66",
        "raw-night": "#151a21",
        "raw-night-raised": "#1e2530",
        "raw-paper-dark": "#eae7e0",
        "raw-muted-dark": "#a8aeb8",
        "raw-petrol": "#0e5e68",
        "raw-petrol-soft": "#4e8a92",
        "raw-petrol-wash": "#d8e4e2",
        "raw-petrol-bright": "#63c0cb",
        "raw-petrol-dim": "#3e7a84",
        "raw-petrol-wash-dark": "#1d2a31",
        "raw-warn": "#b4633f",
        "raw-warn-dark": "#d89372",
        "raw-down": "#a5372a",
        "raw-down-dark": "#e07a63",
        "raw-blush": "#e6a49a"
      }
    },
    "semantic": {
      "note": "semantic: what the rules use, one declaration per colour (as Maison's tokens.css)",
      "tokens": {
        "ground": { "light": "{raw-cloud}", "dark": "{raw-night}" },
        "ground-raised": { "light": "{raw-cloud-deep}", "dark": "{raw-night-raised}" },
        "surface": { "light": "#faf9f5", "dark": "#1a2029" },
        "line": { "light": "#d6d2c6", "dark": "#2e3744" },
        "ink": { "light": "{raw-ink}", "dark": "{raw-paper-dark}" },
        "ink-muted": { "light": "{raw-ink-soft}", "dark": "{raw-muted-dark}" },
        "accent": { "light": "{raw-petrol}", "dark": "{raw-petrol-bright}" },
        "accent-soft": { "light": "{raw-petrol-soft}", "dark": "{raw-petrol-dim}" },
        "accent-wash": { "light": "{raw-petrol-wash}", "dark": "{raw-petrol-wash-dark}" },
        "on-accent": { "light": "{raw-cloud}", "dark": "{raw-night}" },
        "warn-text": { "light": "#8f4b22", "dark": "{raw-warn-dark}" },
        "blocked-wash": { "light": "#f3e2dc", "dark": "#33211f" }
      }
    },
    "heat": {
      "note": "heatmap: one hue, each step further from the surface (1.5:1 or more between neighbours in both themes), so the tiers still read in greyscale and none borrows the colour that means \"down\"",
      "dense": true,
      "tokens": {
        "heat-0": { "light": "#d5e3e2", "dark": "#27383f" },
        "heat-1": { "light": "#9fc0c2", "dark": "#2f5f69" },
        "heat-2": { "light": "#5a959c", "dark": "#4d8f99" },
        "heat-3": { "light": "#0e5e68", "dark": "#8cc4cb" },
        "heat-4": { "light": "#1b222c", "dark": "#e6f4f5" }
      }
    },
    "state": {
      "note": "five states, each colour + shape + word (the colour is the least of the three)",
      "tokens": {
        "st-up": { "light": "{raw-petrol-soft}", "dark": "{raw-petrol-dim}", "note": "graphics, 3:1+" },
        "st-up-text": "{accent}",
        "st-degraded": { "light": "{raw-warn}", "dark": "{raw-warn-dark}" },
        "st-degraded-text": "{warn-text}",
        "st-down": { "light": "{raw-down}", "dark": "{raw-down-dark}" },
        "st-down-text": "{st-down}",
        "st-maint": "{ink-muted}",
        "st-none": { "light": "#87837a", "dark": "#687180" },
        "wash-up": "{accent-wash}",
        "wash-degraded": { "light": "#f5e7da", "dark": "#30261e" },
        "wash-down": "{blocked-wash}",
        "wash-maint": "{ground-raised}",
        "blush": { "light": "{raw-blush}", "dark": "#b8776e" },
        "owl-fill": { "value": "{surface}", "note": "the owl's body: surface, outlined in ink" },
        "owl-line": "{ink}"
      }
    },
    "shadow": {
      "tokens": {
        "shadow-near": { "light": "rgb(27 34 44 / 6%)", "dark": "rgb(0 0 0 / 30%)" },
        "shadow-far": { "light": "rgb(27 34 44 / 6%)", "dark": "rgb(0 0 0 / 25%)" },
        "shadow": "0 1px 2px {shadow-near}, 0 4px 14px {shadow-far}"
      }
    },
    "focus": {
      "tokens": {
        "focus-ring": "3px solid {accent}",
        "focus-offset": "2px"
      }
    },
    "font": {
      "tokens": {
        "font-display": "'Fraunces Variable', Georgia, serif",
        "font-text": "'Cal Sans', system-ui, sans-serif",
        "font-mono": "'Mona Sans Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
      }
    },
    "type": {
      "tokens": {
        "t-hero": "500 clamp(1.75rem, 1.35rem + 1.8vw, 2.6rem)/1.15 {font-display}",
        "t-page": "500 clamp(1.75rem, 1.4rem + 1.4vw, 2.25rem)/1.15 {font-display}",
        "t-section": "500 1.375rem/1.625rem {font-display}",
        "t-group": "500 1.1875rem/1.625rem {font-display}",
        "t-body": "400 1rem/1.5rem {font-text}",
        "t-secondary": "400 0.875rem/1.25rem {font-text}",
        "t-label": "500 0.875rem/1.25rem {font-text}",
        "t-meta": "500 0.8125rem/1rem {font-text}",
        "t-tiny": "500 0.75rem/1rem {font-text}"
      }
    },
    "layout": {
      "dense": true,
      "tokens": {
        "page-max": "2400px",
        "page-margin": "16px",
        "measure": "42rem",
        "measure-wide": "64rem"
      }
    },
    "space": {
      "dense": true,
      "tokens": {
        "s-1": "4px",
        "s-2": "8px",
        "s-3": "12px",
        "s-4": "16px",
        "s-5": "24px",
        "s-6": "32px",
        "s-7": "48px"
      }
    },
    "control": {
      "dense": true,
      "tokens": {
        "control-h": "44px",
        "control-h-s": "36px",
        "control-h-xs": "32px",
        "control-h-l": "52px"
      }
    },
    "radius": {
      "dense": true,
      "tokens": {
        "radius-s": "4px",
        "radius": "6px",
        "radius-m": "8px",
        "radius-l": "10px",
        "radius-xl": "12px",
        "radius-2xl": "16px",
        "radius-pill": "999px"
      }
    },
    "component": {
      "dense": true,
      "tokens": {
        "row-min": "48px",
        "header-h": "56px",
        "glyph": { "value": "16px", "note": "a state's shape beside its word" },
        "bar-day-h": { "value": "22px", "note": "the 90-day bar" },
        "group-col": { "value": "26rem", "note": "a group's column on wide screens" }
      }
    },
    "brand": {
      "note": "the gallery's own: the name in Borel beside the mark, a popover shadow, the half steps",
      "only": ["brand"],
      "tokens": {
        "shadow-pop": "0 10px 30px rgb(27 34 44 / 18%)",
        "font-brand": "'Borel Display', {font-display}",
        "t-brand": "400 1.35rem/1 {font-brand}",
        "s-half": "2px",
        "radius-xs": "2px"
      }
    },
    "docs": {
      "note": "the Starlight theme's own: what its grey ramp and asides need beyond the product's set",
      "only": ["docs"],
      "tokens": {
        "docs-text": { "light": "#2e3540", "dark": "#d9d6cf", "note": "body text, 10.84:1 / 12.04:1" },
        "docs-icon": { "light": "#87837a", "dark": "#6b7380", "note": "icons, borders" },
        "docs-link": { "light": "#0a4a52", "dark": "#a9dde3", "note": "links (accent-high)" },
        "docs-caution-high": { "light": "{warn-text}", "dark": "#ebc2ae" },
        "docs-danger-high": { "light": "{st-down}", "dark": "#f0b3a6" },
        "docs-hairline-shade": { "light": "#c9c4b6", "dark": "{ground}" },
        "docs-backdrop": { "light": "rgb(27 34 44 / 45%)", "dark": "rgb(21 26 33 / 66%)" },
        "docs-line-height": "1.75",
        "docs-line-height-headings": "1.15",
        "docs-content-width": "46rem",
        "docs-h1": "2.75rem",
        "docs-h2": "1.75rem",
        "docs-h3": "1.3125rem",
        "docs-h4": "1.125rem"
      }
    }
  },
  "responsive": [
    { "media": "(min-width: 600px)", "tokens": { "page-margin": "24px" } },
    { "media": "(min-width: 1600px)", "tokens": { "page-margin": "32px" } },
    { "media": "(max-width: 599px)", "tokens": { "row-min": "56px" } },
    { "media": "(pointer: coarse)", "tokens": { "control-h-s": "44px", "control-h-xs": "44px" } }
  ]
}
